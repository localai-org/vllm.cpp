# Copy outside the repository, fill measured local values, then pass the copy to
# tools/bench/run_qwen38_tensorfold_gap.sh. Never place credentials in this file.
ENGINE=vllm-cpp
SOURCE_DIR=
# Full object ID of the exact clean vllm.cpp checkout being measured.
EXPECTED_REVISION=
# sha256sum format: "<64 hex>  <path relative to this manifest>".
ARTIFACT_MANIFEST=
ENDPOINT=http://127.0.0.1:8001/v1/completions
ENDPOINT_READY_URL=http://127.0.0.1:8001/health
MODEL=
TOKENIZER_IDENTITY=
# Direct launch commands use LAUNCH_COMMAND. Serial capture requires all three
# lifecycle commands, including STOP_COMMAND for an already-running server.
LAUNCH_COMMAND=
START_COMMAND=
STOP_COMMAND=
STATUS_COMMAND=
SERVER_LOG_PATH=
# Reads the server log on stdin and writes a secret-free version on stdout.
REDACTION_COMMAND=
MIN_FREE_MEMORY_KIB=
DRAFT=off
CONCURRENCY=1
WAVES=5
# Run only inside a real repository rc lease on dgx:gpu0. RC_DEVICE and
# RC_JOB_ID are supplied by rc and deliberately do not belong in this file.
