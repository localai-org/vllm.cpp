  command = /usr/bin/cmake -E cmake_ninja_dyndep --tdi=tests/CMakeFiles/test_dflash_causality.dir/CXXDependInfo.json --lang=CXX --modmapfmt=gcc --dd=$out @$out.rsp
  description = Generating CXX dyndep file $out
