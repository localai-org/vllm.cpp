#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = /usr/bin/cmake --regenerate-during-build -S/tmp/vllm-region-capture-spec -B/tmp/vllm-region-capture-spec/build2
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = /home/lu_zero/Sources/tt/tt-metal/python_env/bin/ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = /home/lu_zero/Sources/tt/tt-metal/python_env/bin/ninja -t targets
  description = All primary targets available:

