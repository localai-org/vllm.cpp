  command = /usr/bin/cmake -E cmake_ninja_dyndep --tdi=tests/CMakeFiles/test_clm.dir/CXXDependInfo.json --lang=CXX --modmapfmt=gcc --dd=$out @$out.rsp
  description = Generating CXX dyndep file $out
  rspfile = $out.rsp
