  command = /usr/bin/cmake -E cmake_ninja_dyndep --tdi=tests/CMakeFiles/test_fp8_block_linear.dir/CXXDependInfo.json --lang=CXX --modmapfmt=gcc --dd=$out @$out.rsp
  description = Generating CXX dyndep file $out
  rspfile = $out.rsp
  rspfile_content = $in
  restat = 1


