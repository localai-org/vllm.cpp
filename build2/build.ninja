  COMMAND = cd /tmp/vllm-region-capture-spec/build2/examples && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build examples/install/strip: phony examples/CMakeFiles/install/strip.util


#############################################
# Custom command for examples/CMakeFiles/vllm-server-stage

build examples/CMakeFiles/vllm-server-stage | ${cmake_ninja_workdir}examples/CMakeFiles/vllm-server-stage: CUSTOM_COMMAND examples/vllm-server /tmp/vllm-region-capture-spec/scripts/package-server.py || examples/vllm-server libblake3_vendored.a libvllm.a vllm_tenstorrent_ops
  COMMAND = cd /tmp/vllm-region-capture-spec/build2/examples && /home/lu_zero/.local/bin/python3.13 /tmp/vllm-region-capture-spec/scripts/package-server.py --build-dir /tmp/vllm-region-capture-spec/build2 --stage-dir /tmp/vllm-region-capture-spec/build2/release/stage --config Release
  DESC = Installing the vllm-server component into an empty staging prefix


#############################################
# Custom command for examples/CMakeFiles/vllm-server-archive

build examples/CMakeFiles/vllm-server-archive release/vllm.cpp-0.0.3-linux-aarch64-glibc-cpu.tar.gz | ${cmake_ninja_workdir}examples/CMakeFiles/vllm-server-archive ${cmake_ninja_workdir}release/vllm.cpp-0.0.3-linux-aarch64-glibc-cpu.tar.gz: CUSTOM_COMMAND examples/vllm-server /tmp/vllm-region-capture-spec/scripts/package-server.py || examples/vllm-server libblake3_vendored.a libvllm.a vllm_tenstorrent_ops
  COMMAND = cd /tmp/vllm-region-capture-spec/build2/examples && /home/lu_zero/.local/bin/python3.13 /tmp/vllm-region-capture-spec/scripts/package-server.py --build-dir /tmp/vllm-region-capture-spec/build2 --stage-dir /tmp/vllm-region-capture-spec/build2/release/stage --archive /tmp/vllm-region-capture-spec/build2/release/vllm.cpp-0.0.3-linux-aarch64-glibc-cpu.tar.gz --archive-format tar.gz --config Release
  DESC = Creating deterministic installed vllm-server archive
  restat = 1

